@model int

<div class="container mt-5 text-center">

    <h2>Ya respondiste esta actividad</h2>

    <p class="mt-3">
        No puedes responder esta Actividad nuevamente :)
    </p>

    <a asp-controller="Cursos"
       asp-action="Foro"
       asp-route-idCurso="@Model"
       class="btn btn-primary mt-3">
        Volver al Curso
    </a>

</div>