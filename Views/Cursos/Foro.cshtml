@model List<LEARNINGUAM.Web.Models.Actividad>
@using LEARNINGUAM.Web.Models

@{
var curso = ViewBag.Curso;
bool esProfesor = ViewBag.EsProfesor;
bool esAlumno = ViewBag.EsAlumno;
}

@if (TempData["Mensaje"] != null)
{ <div id="mensajeExito" class="alert alert-success text-center shadow">
@TempData["Mensaje"] </div>
}

@if (Context.Request.Query["mensaje"] == "ok")
{ <div id="mensajeExito" class="alert alert-success text-center shadow">
Actividad creada con éxito </div>
}

<div class="mb-3">
    <a asp-controller="Cursos"
       asp-action="Index"
       class="btn btn-outline-secondary">
         Volver a Mis Cursos
    </a>
</div>

<div class="container mt-4">

    <!-- CURSO -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">

            <h2 class="fw-bold">@curso.NombreCurso</h2>

            <p class="text-muted">
                @curso.Descripcion
            </p>

            <span class="badge bg-success">
                Código del curso: @curso.CodigoAcceso
            </span>

        </div>
    </div>

    <!-- BOTONES -->
    @if (esProfesor)
    {
        <div class="mb-4 d-flex gap-2">

            <a asp-controller="Actividades"
            asp-action="Create"
            asp-route-idCurso="@curso.IdCurso"
            class="btn btn-primary">
            + Crear actividad
            </a>

            <button class="btn btn-success"
                    onclick="abrirModalAnuncio(true)">
                + Publicar anuncio
            </button>

        </div>
    }

    @if (ViewBag.Anuncios != null)
    {
        foreach (var anuncio in ViewBag.Anuncios)
        {
            <div class="card p-4 mb-4 anuncio"
                data-archivos='@anuncio.Archivos'>

                <h5>@anuncio.Titulo</h5>

                <p>@anuncio.Contenido</p>

                @{
                    System.Text.Json.JsonElement? archivos = null;

                    if (!string.IsNullOrEmpty(anuncio.Archivos))
                    {
                        archivos = System.Text.Json.JsonSerializer
                            .Deserialize<System.Text.Json.JsonElement>(anuncio.Archivos);
                    }
                }

                @if (archivos.HasValue && archivos.Value.ValueKind != System.Text.Json.JsonValueKind.Null)
                {
                    var data = archivos.Value;

                    // ARCHIVOS
                    if (data.TryGetProperty("archivos", out var arr) &&
                        arr.ValueKind == System.Text.Json.JsonValueKind.Array &&
                        arr.GetArrayLength() > 0)
                    {
                        <div class="mt-3">
                            <strong>Archivos</strong>

                            <div class="d-flex flex-wrap gap-2 mt-2">
                                @foreach (var a in arr.EnumerateArray())
                                {
                                    <span class="archivo-btn">📄 @a.ToString()</span>
                                }
                            </div>
                        </div>
                    }

                    // LINK
                    if (data.TryGetProperty("link", out var linkProp) &&
                        !string.IsNullOrEmpty(linkProp.ToString()))
                    {
                        <div class="mt-2">
                            <strong>Link:</strong>
                            <a href="@linkProp.ToString()" target="_blank">
                                @linkProp.ToString()
                            </a>
                        </div>
                    }
                }

                @if (esProfesor)
                {
                    <div class="mt-3 d-flex gap-2">

                        <button type="button" class="btn btn-warning btn-sm text-dark"
                                onclick="editarAnuncio(@anuncio.IdAnuncio, this)">
                            Editar
                        </button>

                        <button type="button"
                                class="btn btn-danger btn-sm"
                                onclick="eliminarAnuncio(@anuncio.IdAnuncio)">
                            Eliminar
                        </button>

                    </div>
                }

                <small class="text-muted">
                    @anuncio.Fecha.ToString("dd/MM/yyyy HH:mm")
                </small>

            </div>
        }
    }

    @if (esAlumno && Model.Count == 0)
    {
        <div class="alert alert-info">
            Aún no hay actividades disponibles en este curso.
        </div>
    }

    @if (Model.Count > 0)
    {
        @foreach (var act in Model)
        {
            <div class="card mb-3 shadow-sm">

                <div class="card-body">

                    <h5 class="card-title">@act.Titulo</h5>

                    <p class="card-text">@act.Descripcion</p>

                    <small class="text-muted">
                        Tipo: @act.Tipo |
                        Fecha: @act.FechaCreacion.ToString("dd/MM/yyyy")
                    </small>

                    <div class="mt-3 d-flex gap-2">

                    @if (esProfesor)
                        {
                            if (act.Tipo == "SELECCIONAR")
                            {
                                <a asp-controller="Seleccionar"
                                asp-action="Seleccionar"
                                asp-route-idActividad="@act.IdActividad"
                                asp-route-idCurso="@curso.IdCurso"
                                class="btn btn-warning btn-sm">
                                    Editar actividad
                                </a>
                            }
                            else if (act.Tipo == "ARRASTRAR")
                            {
                                <a asp-controller="Arrastrar"
                                asp-action="Arrastrar"
                                asp-route-idActividad="@act.IdActividad"
                                class="btn btn-warning btn-sm">
                                    Editar actividad
                                </a>
                            }
                            else if (act.Tipo == "CUESTIONARIO")
                            {
                                var db = Context.RequestServices
                                    .GetService(typeof(ApplicationDbContext)) as ApplicationDbContext;

                                var cuestionario = db.Cuestionarios
                                    .FirstOrDefault(c => c.IdActividad == act.IdActividad);

                                if (cuestionario != null)
                                {
                                    <a asp-controller="Preguntas"
                                    asp-action="Create"
                                    asp-route-idCuestionario="@cuestionario.IdCuestionario"
                                    asp-route-idCurso="@curso.IdCurso"
                                    class="btn btn-warning btn-sm">
                                        Editar actividad
                                    </a>
                                }
                            }
                        }

                        @if (esAlumno)
                        {
                            <a asp-controller="Actividades"
                            asp-action="Detalles"
                            asp-route-idActividad="@act.IdActividad"
                            class="btn btn-success btn-sm">
                                Resolver actividad
                            </a>
                        }

                        @if (esProfesor)
                        {
                            <form asp-controller="Actividades"
                                asp-action="Eliminar"
                                method="post"
                                style="display:inline;">

                                <input type="hidden"
                                    name="idActividad"
                                    value="@act.IdActividad" />

                                <button type="submit"
                                        class="btn btn-danger btn-sm"
                                        onclick="return confirm('¿Eliminar esta actividad?')">
                                    Eliminar
                                </button>

                            </form>
                        }

                    </div>

                </div>

            </div>
        }
    }
</div>

<!-- MODAL -->

<div class="modal fade" id="modalAnuncio">

    <div class="modal-dialog modal-lg">
        <div class="modal-content p-4">

            <h5 class="mb-3">Nuevo anuncio</h5>

            <input type="text"
                id="tituloAnuncio"
                class="form-control mb-3"
                placeholder="Título del anuncio">

            <textarea id="contenidoAnuncio"
                    class="form-control mb-3"
                    rows="3"
                    placeholder="Escribe aquí tu anuncio..."></textarea>

            <div id="previewArchivos" class="mb-3"></div>

            <div class="d-flex gap-2">

                <label class="btn btn-outline-primary btn-sm">
                    Subir Archivo
                    <input type="file" multiple hidden id="inputArchivos">
                </label>

                <button class="btn btn-outline-secondary btn-sm"
                        onclick="toggleLink()">
                        Agregar Link 
                </button>

            </div>

            <div id="inputLink" class="mt-3" style="display:none;">
                <input type="text"
                    id="linkInput"
                    class="form-control"
                    placeholder="https://ejemplo.com">
            </div>

            <button class="btn btn-success mt-3"
                    onclick="publicarAnuncio()">
                Publicar
            </button>

        </div>
    </div>

</div>


<style>
    #mensajeExito {
        transition: opacity 0.5s ease;
    }
</style>

<script>
    console.log("SCRIPT CARGADO");
    setTimeout(() => {
        let alerta = document.getElementById("mensajeExito");
        if (alerta) {
            alerta.style.opacity = "0";
            setTimeout(() => {
                alerta.remove();
            }, 500);
        }
    }, 3500);

    function abrirModalAnuncio(limpiar = true) {

        if (limpiar) {
            modoEdicion = false;
            idAnuncioEditar = null;

            document.getElementById("tituloAnuncio").value = "";
            document.getElementById("contenidoAnuncio").value = "";
            document.getElementById("linkInput").value = "";
            document.getElementById("previewArchivos").innerHTML = "";

            archivosSeleccionados = [];
        }

        let modal = new bootstrap.Modal(
            document.getElementById('modalAnuncio')
        );
        modal.show();
    }

    let modoEdicion = false;
    let idAnuncioEditar = null;
    let archivosSeleccionados = [];

    var inputFile = document.getElementById("inputArchivos");

    if (inputFile) {
        inputFile.addEventListener("change", function () {

            let preview = document.getElementById("previewArchivos");
            preview.innerHTML = "";
            archivosSeleccionados = [];

            Array.from(this.files).forEach(f => {
                archivosSeleccionados.push(f.name);

                let div = document.createElement("div");
                div.innerText = "📄 " + f.name;
                preview.appendChild(div);
            });
        });
    }

    function toggleLink() {
        let link = document.getElementById("inputLink");
        link.style.display =
            link.style.display === "none" ? "block" : "none";
    }

    function editarAnuncio(id, btn) {

        if (!btn) {
            console.log("Botón no recibido");
            return;
        }

        let card = btn.closest(".anuncio");

        if (!card) {
            console.log("No se encontró la card del anuncio");
            return;
        }

        let titulo = card.querySelector("h5")?.innerText || "";
        let contenido = card.querySelector("p")?.innerText || "";

        document.getElementById("tituloAnuncio").value = titulo;
        document.getElementById("contenidoAnuncio").value = contenido;

        let data = card.getAttribute("data-archivos");

        archivosSeleccionados = [];
        document.getElementById("previewArchivos").innerHTML = "";
        document.getElementById("linkInput").value = "";
        document.getElementById("inputLink").style.display = "none";

        if (data && data !== "null") {
            try {
                let json = JSON.parse(data);

                if (json.archivos && Array.isArray(json.archivos)) {
                    json.archivos.forEach(f => {
                        archivosSeleccionados.push(f);

                        let div = document.createElement("div");
                        div.innerText = "📄 " + f;
                        document
                            .getElementById("previewArchivos")
                            .appendChild(div);
                    });
                }

                if (json.link && json.link.trim() !== "") {
                    document.getElementById("linkInput").value = json.link;
                    document.getElementById("inputLink").style.display = "block";
                }

            } catch (error) {
                console.error("Error al parsear archivos:", error);
            }
        }

        modoEdicion = true;
        idAnuncioEditar = id;

        let modal = new bootstrap.Modal(
            document.getElementById('modalAnuncio')
        );
        modal.show();
    }


    function publicarAnuncio() {
        let titulo = document.getElementById("tituloAnuncio").value;
        let contenido = document.getElementById("contenidoAnuncio").value;
        let link = document.getElementById("linkInput").value;

        let idCurso = @curso.IdCurso;

        let dataArchivos = {
            archivos: archivosSeleccionados,
            link: link
        };

        let url = '/Anuncios/Crear';

        let bodyData = {
            IdCurso: idCurso,
            Titulo: titulo,
            Contenido: contenido,
            Archivos: JSON.stringify(dataArchivos)
        };

        if (modoEdicion) {
            url = '/Anuncios/Editar';
            bodyData.IdAnuncio = idAnuncioEditar; 
        }

        fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(bodyData)
        })
        .then(res => res.json())
        .then(data => {

            if (data.success) {

                modoEdicion = false;
                idAnuncioEditar = null;

                // limpiar campos
                document.getElementById("tituloAnuncio").value = "";
                document.getElementById("contenidoAnuncio").value = "";
                document.getElementById("linkInput").value = "";
                document.getElementById("previewArchivos").innerHTML = "";

                archivosSeleccionados = [];

                location.reload();
            }

        });
    }

    function eliminarAnuncio(id) {

        console.log("Eliminar ID:", id);

        if (!confirm("¿Eliminar este anuncio?")) return;

        fetch('/Anuncios/Eliminar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ idAnuncio: id }) 
        })
        .then(res => res.json())
        .then(data => {

            console.log(data);

            if (data.success) {
                location.reload();
            }

        })
        .catch(err => console.error(err));
    }
</script>
