@{
    
    ViewData["Title"] = "Inicio de Sesión";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Inicio de Sesión</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            margin: 0;
            padding: 0;
        }

        .left-panel {
            background: linear-gradient(135deg, #05a8aa, #00345c);
            color: white;
            height: 100vh;
        }

        .right-panel {
            background-color: #f8f9fa;
            height: 100vh;
        }

        .login-card {
            background: white;
            border-radius: 20px;
            padding: 40px;
            width: 100%;
            max-width: 400px;
            transition: transform 0.3s;
        }

        .login-card:hover {
            transform: scale(1.02);
        }

        .brand-title {
            font-size: 42px;
            font-weight: bold;
            color: #f8273d;
        }

        .google-btn {
            background-color: #db4437;
            color: white;
            font-weight: bold;
        }

        .google-btn:hover {
            background-color: #c23321;
        }

        .footer {
            position: absolute;
            bottom: 0;
            width: 100%;
            background: transparent;
            font-size: 14px;
            color: black
        }
    </style>
</head>

<body>

    <div class="container-fluid">
        <div class="row">

            <!-- LADO IZQUIERDO -->
            <div class="col-md-6 d-flex flex-column justify-content-center align-items-center left-panel">

                <div class="text-center px-4">
                    <h1 class="fw-bold display-4">Welcome to LEARNING UAM</h1>

                    <p class="mt-4 fs-5">
                        Herramienta de ayuda para la enseñanza y 
                        el aprendizaje del Idioma Inglés proporcionada por 
                        la Universidad Autónoma Metropolitana. 
                    </p>

                    <!--a href="https://www.cua.uam.mx/oferta-educativa/lenguas" class="btn btn-outline-light btn-lg mt-3"><i><b><u>Conoce más sobre los Idiomas</u></b></i></a-->
                    <a href="https://www.cua.uam.mx/oferta-educativa/lenguas" class="btn btn-outline-light btn-lg mt-3" target="_blank"><i><b><u>Conoce más sobre los Idiomas</u></b></i></a>

                </div>

            </div>

            <!-- LADO DERECHO -->
            <div class="col-md-6 d-flex justify-content-center align-items-center right-panel">

                <div class="login-card shadow-lg text-center">

                    <div class="brand-title mb-3">
                        Ingresar a Learning UAM
                    </div>

                    <a href="/Auth/LoginGoogle"
                       class="btn google-btn w-100 py-2 mb-3">
                         Acceder con Google
                    </a>

                    <small class="text-muted">
                        Puedes Iniciar Sesión con un correo personal o Institucional.
                    </small> </br></br></br></br>

                    <div class="mt-3">
                        <a asp-controller="Home"
                        asp-action="Privacy"
                        target="_blank"
                        class="btn btn-outline-secondary">
                            Ingresar como invitado
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>

    <!--footer class="footer text-center py-3">
        <div class="text-dark">
            <i><b><u>© 2026 LEARNING UAM ·</u></b></i>
        </div>
    </footer-->

</body>
</html>