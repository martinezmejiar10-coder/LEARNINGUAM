<h1>ID Curso: @ViewBag.IdCurso</h1>

<div class="container mt-5">
    <div class="d-flex justify-content-center">
        <div class="card shadow p-5 text-center" style="border-radius:20px; max-width:500px;">

            <h3 class="mb-4">¿Qué deseas hacer ahora?</h3>

            <div class="d-grid gap-3">

                <a asp-controller="Actividades"
                   asp-action="Create"
                   asp-route-idCurso="@ViewBag.IdCurso"
                   class="btn btn-success btn-lg">
                    Crear Nueva Actividad
                </a>

                <a asp-controller="Cursos"
                   asp-action="Foro"
                   asp-route-idCurso="@ViewBag.IdCurso"
                   class="btn btn-primary btn-lg">
                    Volver al curso
                </a>

            </div>

        </div>
    </div>
</div>